APP_NAME="GPHA EMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_COOKIE=gpha_ems_session
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="ems@gpha.gov.gh"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# GPHA Central Login (replace placeholders with issued EMS application values)
GPHA_SSO_ISSUER=GPHACentralLogin
GPHA_SSO_AUDIENCE=EMS
GPHA_SSO_ALLOWED_AUDIENCES=EMS,CentralLogin
GPHA_SSO_MODULE_ID=45323319-3126-4717-8ce2-95b8fb5f055f
GPHA_SSO_APP_ID=EMS
GPHA_SSO_APP_KEY=
GPHA_SSO_SHARED_SECRET=
GPHA_SSO_CENTRAL_LOGIN_URL=http://172.16.0.129:8076/auth/login
GPHA_SSO_RETURN_URL=http://127.0.0.1:8001/sso/login
GPHA_SSO_BASE_URL=http://172.16.0.129:8075
GPHA_SSO_APP_ACCESS_PERMISSIONS_ENDPOINT=http://172.16.0.129:8075/api/app-access/user-permissions
GPHA_SSO_TOKEN_TTL_MINUTES=3
GPHA_SSO_CLOCK_SKEW_SECONDS=30
GPHA_SSO_PERMISSION_CACHE_SECONDS=120

EMS_MAIL_NOTIFICATIONS_ENABLED=false
